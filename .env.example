API_KEY=your-api-key
RATE_LIMIT_WINDOW_MIN=10
RATE_LIMIT_MAX=30
TEMPLATE_PATH=./your-template.docx
PORT=8080
TRUST_PROXY_HOPS=2

# Depuración: solo en local; en Railway/producción dejar en 0 o sin definir (evita volcar payloads enormes).
LOG_REQUEST_BODY=0
# Opcional: límite de caracteres por campo en templateVars (por defecto 8000; 0 = sin truncar).
LOG_REQUEST_BODY_MAX_FIELD_CHARS=8000