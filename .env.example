API_KEY=your-api-key
RATE_LIMIT_WINDOW_MIN=10
RATE_LIMIT_MAX=30
TEMPLATE_PATH=./your-template.docx
PORT=8080
TRUST_PROXY_HOPS=2

# Depuración: en consola del servidor, volcar el JSON del POST /convert (templateBase64 se resume por tamaño).
LOG_REQUEST_BODY=1
# Opcional: límite de caracteres por campo en templateVars (por defecto 8000; 0 = sin truncar).
LOG_REQUEST_BODY_MAX_FIELD_CHARS=8000